{
  "name": "typeorm-procedure-kit",
  "version": "2.3.1",
  "packageManager": "npm@11.19.0",
  "description": "Enterprise TypeORM toolkit for Oracle and PostgreSQL with strongly-typed repositories, stored procedures, multi-database entity inheritance, raw SQL orchestration, notifications, and an enhanced bundled TypeORM runtime",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./nestjs": {
      "types": "./dist/types/nest/index.d.ts",
      "import": "./dist/esm/nest/index.js",
      "require": "./dist/cjs/nest/index.js",
      "default": "./dist/esm/nest/index.js"
    },
    "./typeorm": {
      "types": "./dist/types/typeorm/index.d.ts",
      "import": "./dist/esm/typeorm/index.js",
      "require": "./dist/cjs/typeorm/index.js",
      "default": "./dist/esm/typeorm/index.js"
    },
    "./typeorm-extend": {
      "types": "./dist/types/typeorm-extend/index.d.ts",
      "import": "./dist/esm/typeorm-extend/index.js",
      "require": "./dist/cjs/typeorm-extend/index.js",
      "default": "./dist/esm/typeorm-extend/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*tsbuildinfo*",
    "!dist/**/*.map",
    "package.json",
    "docs",
    "CHANGELOG.md",
    "LICENSE.md",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "npm run clean && npm run lint && npm run build:esm && npm run build:cjs && npm run check:dist",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json', '{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "benchmark:postgre-materialization": "npm run build:esm && node scripts/benchmark-postgre-materialization.mjs",
    "clean": "node -e \"const fs = require('node:fs'); for (const path of ['dist', '.cache/typescript']) fs.rmSync(path, { recursive: true, force: true })\"",
    "check": "npm run typecheck && npm run typecheck:test && npm run lint && npm run test && npm run check:runtime",
    "check:runtime": "npm run clean && npm run build:esm && npm run build:cjs && npm run check:dist && npm run check:package-consumer",
    "check:dist": "npm run check:circular && npm run check:esm-imports && npm run check:cjs-imports",
    "check:circular": "madge --circular --extensions js dist/esm && madge --circular --extensions js dist/cjs",
    "check:esm-imports": "node --input-type=module -e \"await import('typeorm-procedure-kit'); await import('typeorm-procedure-kit/nestjs'); await import('typeorm-procedure-kit/typeorm'); await import('typeorm-procedure-kit/typeorm-extend')\"",
    "check:cjs-imports": "node -e \"require('typeorm-procedure-kit'); require('typeorm-procedure-kit/nestjs'); require('typeorm-procedure-kit/typeorm'); require('typeorm-procedure-kit/typeorm-extend')\"",
    "check:package-consumer": "node scripts/check-package-consumer.mjs",
    "check:audit:production": "npm audit --omit=dev --audit-level=high",
    "check:audit:build": "npm audit --audit-level=moderate",
    "prepublishOnly": "npm run check:ci",
    "lint": "npm run lint:owned && npm run lint:typeorm && npm run lint:test",
    "lint:owned": "eslint \"src/**/*.ts\" --ignore-pattern \"src/typeorm/**\" --no-error-on-unmatched-pattern",
    "lint:typeorm": "eslint \"src/typeorm/**/*.ts\" --no-error-on-unmatched-pattern",
    "lint:test": "eslint \"test/**/*.ts\" \"vitest.config.ts\" --no-error-on-unmatched-pattern",
    "lint:fix": "npm run lint:fix:owned && npm run lint:fix:test",
    "lint:fix:owned": "npm run lint:owned -- --fix",
    "lint:fix:test": "npm run lint:test -- --fix",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=reports/vitest/junit.xml",
    "test:watch": "vitest",
    "check:ci": "npm run typecheck && npm run typecheck:test && npm run lint && npm run test:ci && npm run check:runtime",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "typeorm",
    "typeorm-fork",
    "typeorm-0.3",
    "typescript",
    "orm",
    "postgresql",
    "postgres",
    "pg",
    "oracle",
    "oracledb",
    "stored-procedures",
    "procedure-call",
    "plsql",
    "raw-sql",
    "sql-transactions",
    "database-notifications",
    "listen-notify",
    "oracle-cqn",
    "continuous-query-notification",
    "refcursor",
    "entity-metadata",
    "query-runner",
    "data-source",
    "serializers",
    "nestjs",
    "type-safe"
  ],
  "author": "Paul Budanov",
  "license": "MIT",
  "homepage": "https://github.com/PaulBudanov/typeorm-procedure-kit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/PaulBudanov/typeorm-procedure-kit.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/PaulBudanov/typeorm-procedure-kit/issues"
  },
  "dependencies": {
    "@types/luxon": "^3.7.1",
    "@types/oracledb": "^7.0.1",
    "@types/pg": "^8.16.0",
    "app-root-path": "^3.1.0",
    "dedent": "^1.7.1",
    "dotenv": "^17.3.1",
    "glob": "^13.0.3",
    "lodash": "^4.18.1",
    "lru-cache": "^11.2.7",
    "luxon": "^3.7.2",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.4.16 || ^11.0.16",
    "oracledb": "^6.0.0 || ^7.0.0",
    "pg": "^8.5.1",
    "pg-query-stream": "^4.12.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "pg-query-stream": {
      "optional": true
    },
    "oracledb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/common": "^10.4.16 || ^11.0.16",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20.19.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "madge-ts6": "^8.1.0",
    "oracledb": "^7.0.0",
    "pg": "^8.17.2",
    "pg-query-stream": "^4.12.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": [
    "./dist/cjs/index.js",
    "./dist/cjs/typeorm/index.js",
    "./dist/esm/index.js",
    "./dist/esm/typeorm/index.js"
  ]
}
